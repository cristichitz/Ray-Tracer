bx 0,-4,23  2,-2,25  168,69,54  brick
bx 2,-4,23  4,-2,25  199,184,158  brick
bx 4,-4,23  6,-2,25  168,69,54  brick
bx 6,-4,23  8,-2,25  199,184,158  brick
bx -8,-2,23  -6,0,25  199,184,158  brick
bx -6,-2,23  -4,0,25  168,69,54  brick
bx -4,-2,23  -2,0,25  199,184,158  brick
bx -2,-2,23  0,0,25  168,69,54  brick
bx 0,-2,23  2,0,25  199,184,158  brick
bx 2,-2,23  4,0,25  168,69,54  brick
bx 4,-2,23  6,0,25  199,184,158  brick
bx 6,-2,23  8,0,25  168,69,54  brick
