# Cannonball vs brick wall - bonus physics demo
# Run: ./miniRT_bonus bonus/scenes/brick_wall.rt   (SPACE fires the ball)
# Material keyword drives physics: brick = dynamic box, metal = heavy ball,
# planes have no keyword so they are static colliders (floor + Cornell walls).

C  0,2,-24    0,-0.08,1   55
A  0.25       150,165,195
# ceiling quad area light over the wall, material "light"
qu -6,15.8,10 12,0,0      0,0,12        255,245,225   light

# --- floor stays an infinite plane: it is the collision surface for the
# bricks and ball (physics colliders are harvested from planes only) ---
pl 0,-8,0      0,1,0      200,200,200
# other walls are finite quads (render-only, nothing collides with them) so
# escaped rays terminate at the open front instead of hitting infinite planes
qu -14,16,-24  28,0,0     0,0,60       200,200,200
qu -14,-8,36   28,0,0     0,24,0       200,200,200
qu -14,-8,-24  0,24,0     0,0,60       200,40,40
qu 14,-8,-24   0,24,0     0,0,60       40,180,60

# --- brick wall: 8 x 6 dynamic boxes (2x2x2), checkerboard colours ---
bx -8,-8,23  -6,-6,25  168,69,54  brick
bx -6,-8,23  -4,-6,25  199,184,158  brick
bx -4,-8,23  -2,-6,25  168,69,54  brick
bx -2,-8,23  0,-6,25  199,184,158  brick
bx 0,-8,23  2,-6,25  168,69,54  brick
bx 2,-8,23  4,-6,25  199,184,158  brick
bx 4,-8,23  6,-6,25  168,69,54  brick
bx 6,-8,23  8,-6,25  199,184,158  brick
bx -8,-6,23  -6,-4,25  199,184,158  brick
bx -6,-6,23  -4,-4,25  168,69,54  brick
bx -4,-6,23  -2,-4,25  199,184,158  brick
bx -2,-6,23  0,-4,25  168,69,54  brick
bx 0,-6,23  2,-4,25  199,184,158  brick
bx 2,-6,23  4,-4,25  168,69,54  brick
bx 4,-6,23  6,-4,25  199,184,158  brick
bx 6,-6,23  8,-4,25  168,69,54  brick
bx -8,-4,23  -6,-2,25  168,69,54  brick
bx -6,-4,23  -4,-2,25  199,184,158  brick
bx -4,-4,23  -2,-2,25  168,69,54  brick
