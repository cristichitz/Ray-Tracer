# Cornell box - bonus physics demo (canonical proportions, scaled down 10x)
# Run: ./miniRT_bonus bonus/scenes/cornell_box.rt
# Same walls / light / boxes layout as the built-in make_cornell_box. The short
# box is a true cube so it is a dynamic rigid body; the tall box is non-cube and
# the engine models a box collider as a cube, so it is kept static (it would
# sink as a dynamic body). SPACE launches the box under the screen centre;
# left-click shoves a body straight ahead.

C  27.8,27.8,-80   0,0,1     40
A  0.0             0,0,0
# ceiling quad area light (same rectangle as make_cornell_box)
qu 21.3,55.4,22.7  13,0,0    0,0,10.5      255,250,235   light

# --- walls as static planes (scenery + colliders) ---
pl 27.8,0,27.8     0,1,0      186,186,186
pl 27.8,55.5,27.8  0,-1,0     186,186,186
pl 27.8,27.8,55.5  0,0,-1     186,186,186
pl 0,27.8,27.8     1,0,0      166,13,13
pl 55.5,27.8,27.8  -1,0,0     31,115,38

# --- the two classic boxes (axis-aligned, make_cornell_box dims / 10) ---
bx 21.25,8.25,14.75   16.5,16.5,16.5   186,186,186   rubber
bx 34.75,16.5,37.75   16.5,33,16.5     186,186,186
