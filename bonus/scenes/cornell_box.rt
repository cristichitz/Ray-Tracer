# Mandatory Cornell box (scenes/cornell_box.rt) scaled down 10x.
# Smaller world => the fixed camera MOVE_SPEED covers it faster.
# Walls are finite qu quads (open front) so escaped rays terminate = fast.
C 2,2,-6      0,0,1     40
A 0.0         0,0,0

# small ceiling area light (qu, not L: a global-radius L would overflow a 4-unit box)
qu 1.5,3.95,1.5  1,0,0    0,0,1      255,250,235   light

# --- walls as finite quads (matches the mandatory scene / 10) ---
qu 4,0,0   0,4,0   0,0,4    31,115,38
qu 0,0,0   0,4,0   0,0,4    166,13,13
qu 0,0,0   4,0,0   0,0,4    186,186,186
qu 4,4,4   -4,0,0  0,0,-4   186,186,186
qu 0,0,4   4,0,0   0,4,0    186,186,186

# --- the two classic boxes (corners, mandatory values / 10) ---
bx 0.937,0,0.468   2.126,1.189,1.658   186,186,186 rubber  
bx 1.910,0,2.126   3.099,2.378,3.315   186,186,186 rubber
